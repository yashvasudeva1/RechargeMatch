# Google Maps Platform API Key (Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# AWS Credentials for Zero-CLI Node.js Deployment (npm run aws:deploy)
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# AWS Backend Integration (Auto-populated by `npm run aws:deploy`)
VITE_AWS_REGION="ap-south-1"
VITE_AWS_API_GATEWAY_URL=""
VITE_AWS_S3_BUCKET_URL=""
